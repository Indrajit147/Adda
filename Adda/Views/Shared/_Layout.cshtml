<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Adda</title>
    <link href="~/images/favicon.jpg" rel="icon" type="image/jpeg" />
    <link rel="stylesheet" href="~/css/s.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tailwind.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Adda.styles.css" asp-append-version="true" />
</head>
<body>
    <div id="wrapper">
        @* Topbar *@
        <partial name="Navigation/_Topbar"></partial>
        @* Side bar(left) *@
        <partial name="Navigation/_Sidebar"></partial>
        @RenderBody()
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
   

    @* Asset scripts *@
    <script src="~/js/uikit.min.js"></script>
    <script src="~/js/simplebar.js"></script>
    <script src="~/js/script.js"></script>

   @* Ion Icon *@
    <script type="module"
        src="https://unpkg.com/ionicons@5.5.2/dist/ionicons/ionicons.esm.js"
        defer></script>

    <script nomodule
        src="https://unpkg.com/ionicons@5.5.2/dist/ionicons/ionicons.js"
        defer></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
